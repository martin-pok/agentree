{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "dist/web",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(js|css|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(fonts|logos|brand|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache"
        }
      ]
    },
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
