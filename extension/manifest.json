{
  "manifest_version": 3,
  "name": "Agenteeq – AI agenti v reálném čase",
  "short_name": "Agenteeq",
  "version": "0.5.0",
  "description": "Posílá stav a přepis konverzací z webových AI aplikací do Agenteeq na tomto počítači (127.0.0.1).",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:4620/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Agenteeq", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.qwen.ai/*",
        "https://github.com/copilot*"
      ],
      "js": ["sites.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
