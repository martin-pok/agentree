  "type": "module",
  "bin": {
    "agentree": "bin/agentree.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node bin/agentree.mjs",
    "dev": "node --watch-path=src --watch-path=bin bin/agentree.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "check": "node --check bin/agentree.mjs && node scripts/check-syntax.mjs"
  },
