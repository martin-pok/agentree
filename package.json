{
  "name": "agenteeq",
  "version": "0.18.0",
  "private": true,
  "description": "Agenteeq – všichni AI agenti na jednom místě v reálném čase: Claude, ChatGPT/Codex, Copilot, Gemini, Cursor, Perplexity, Grok, Qwen.",
  "type": "module",
  "bin": {
    "agenteeq": "bin/agenteeq.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "extension/",
    "docs/INSTALL.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:mac": "mkdir -p dist && node scripts/build-macos.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "icon:windows": "node scripts/make-ico.mjs",
    "build:site": "node scripts/build-site.mjs",
    "release:mac": "node scripts/release-mac.mjs",
    "start": "node bin/agenteeq.mjs",
    "dev": "node --watch-path=src --watch-path=bin bin/agenteeq.mjs",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/**/*.test.mjs\"",
    "check": "node --check bin/agenteeq.mjs && node scripts/check-syntax.mjs",
    "pack": "mkdir -p dist && npm pack --pack-destination dist",
    "smoke": "node scripts/smoke-package.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "license": "node scripts/license.mjs",
    "qa:desktop": "node scripts/qa-desktop.mjs",
    "qa:contrast": "node scripts/qa-contrast.mjs",
    "qa:site": "node scripts/qa-site.mjs",
    "qa:extension": "node scripts/qa-extension.mjs",
    "showcase": "node scripts/showcase.mjs",
    "qa:keychain": "node scripts/qa-keychain.mjs",
    "fonts:vendor": "node scripts/vendor-fonts.mjs"
  },
  "license": "UNLICENSED"
}
